{
  "nodeModulesDir": "auto",
  "tasks": {
    "dev": "vite",
    "build": "vite build",
    "build:lib": "vite build --config vite.lib.config.ts",
    "preview": "vite preview",
    "check": "deno check src/**/*.ts src/**/*.tsx vite.config.ts vite.lib.config.ts",
    "test": "deno test --allow-all src",
    "verify": "deno fmt --check && deno lint && deno task check && deno task test && deno task build && deno task build:lib"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  },
  "fmt": {
    "lineWidth": 100,
    "singleQuote": false,
    "semiColons": true
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@tailwindcss/vite": "npm:@tailwindcss/vite@^4.3.3",
    "@types/react": "npm:@types/react@^19.2.18",
    "@types/react-dom": "npm:@types/react-dom@^19.2.4",
    "@vitejs/plugin-react": "npm:@vitejs/plugin-react@^6.0.5",
    "daisyui": "npm:daisyui@^5.7.16",
    "lucide-react": "npm:lucide-react@^1.30.0",
    "react": "npm:react@^19.2.8",
    "react-dom": "npm:react-dom@^19.2.8",
    "react-dom/client": "npm:react-dom@^19.2.8/client",
    "react/jsx-runtime": "npm:react@^19.2.8/jsx-runtime",
    "tailwindcss": "npm:tailwindcss@^4.3.3",
    "typescript": "npm:typescript@^7.0.2",
    "vite": "npm:vite@^8.2.1"
  }
}
