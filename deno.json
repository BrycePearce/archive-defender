{
  "nodeModulesDir": "auto",
  "tasks": {
    "dev": "vite",
    "build": "vite build",
    "build:lib": "vite build --config vite.lib.config.ts && tsc -p tsconfig.package.json",
    "verify:package": "tsc -p tools/package-consumer/tsconfig.json && node tools/verify-package.mjs",
    "preview": "vite preview",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "lint": "deno lint",
    "check": "deno check src/**/*.ts src/**/*.tsx vite.config.ts vite.lib.config.ts && tsc -p tsconfig.package.json --noEmit",
    "test": "deno test --allow-all src",
    "precommit": "deno task fmt:check && deno task lint",
    "verify": "deno task fmt:check && deno task lint && deno task check && deno task test && deno task build && deno task build:lib && deno task verify:package",
    "hooks:install": "deno run --allow-run=git --allow-write=.githooks tools/install_hooks.ts"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  },
  "fmt": {
    "lineWidth": 100,
    "singleQuote": false,
    "semiColons": true
  },
  "lint": {
    "include": ["src", "tools", "vite.config.ts", "vite.lib.config.ts"],
    "rules": {
      "tags": ["recommended", "react"]
    }
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@tailwindcss/vite": "npm:@tailwindcss/vite@^4.3.3",
    "@types/react": "npm:@types/react@^19.2.18",
    "@types/react-dom": "npm:@types/react-dom@^19.2.4",
    "@vitejs/plugin-react": "npm:@vitejs/plugin-react@^6.0.5",
    "daisyui": "npm:daisyui@^5.7.16",
    "lucide-react": "npm:lucide-react@^1.30.0",
    "react": "npm:react@^19.2.8",
    "react-dom": "npm:react-dom@^19.2.8",
    "react-dom/client": "npm:react-dom@^19.2.8/client",
    "react/jsx-runtime": "npm:react@^19.2.8/jsx-runtime",
    "tailwindcss": "npm:tailwindcss@^4.3.3",
    "vite": "npm:vite@^8.2.1"
  }
}
